FROM node:20-slim AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
COPY hcultdb/ /tmp/pkgs/hcultdb/
COPY hcultinf/ /tmp/pkgs/hcultinf/
COPY hcultctrl/ /tmp/pkgs/hcultctrl/
RUN pip install --no-cache-dir /tmp/pkgs/hcultdb /tmp/pkgs/hcultinf /tmp/pkgs/hcultctrl \
    && rm -rf /tmp/pkgs
COPY --from=frontend /frontend/dist /opt/frontend
ENV HCULT_FRONTEND_DIR=/opt/frontend
WORKDIR /app
